{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nisar-hazard-watch-backend-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/|data/|cesium/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
