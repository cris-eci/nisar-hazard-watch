{
  "name": "nisar-hazard-watch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "frames:fetch": "tsx --tsconfig tsconfig.node.json scripts/fetch-frames.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "cesium": "^1.146.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,css,md}": "prettier --write"
  },
  "description": "See how Earth changes through clouds, smoke and darkness: NISAR radar on a 3D globe (NASA Space Apps 2026).",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@8.15.0"
}
